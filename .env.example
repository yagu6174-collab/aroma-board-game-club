EDITOR_PASSWORD=
SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave blank to use https://aroma-board-game-club.vercel.app/api/google/callback
GOOGLE_REDIRECT_URI=
# Shared secret for POST /api/google/hook. Set one long random value in Vercel.
# FORM_HOOK_SECRET is preferred. The hook also accepts CRON_SECRET. Never commit either value.
FORM_HOOK_SECRET=
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> to GET /api/google/cron every hour.
# Set this in the Vercel project. The hourly sync stays unauthorized until it is set.
CRON_SECRET=
